<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="igvc_robot">
    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <child link="part_1"/>
        <axis xyz="0 0 1"/>
    </joint>

    <xacro:include filename="$(find igvc_description)/urdf/model.urdf.xacro"/>
    <!-- <xacro:include filename="$(find igvc_description)/urdf/control.urdf.xacro"/> -->
    <xacro:include filename="$(find igvc_description)/urdf/sensors.urdf.xacro"/>

</robot>