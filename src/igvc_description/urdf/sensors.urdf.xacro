<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find depthai_descriptions)/urdf/include/depthai_macro.urdf.xacro"/>

    <xacro:depthai_camera 
        camera_name="oak_depth"
        camera_model="OAK-D-POE"
        base_frame="camera_link" 
        parent="base_footprint"
        cam_pos_x="0.0"
        cam_pos_y="-0.4"
        cam_pos_z="0.8"
        cam_roll="0.0"
        cam_pitch="0.0"
        cam_yaw="${pi/2}"
        rs_compat="true"
    />

    <joint name="camera_base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="camera_link"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_link_optical"></link>
    
    <gazebo reference="camera_link">
        <sensor name="oak_depth" type="depth">
            <pose> 0 0 0 0 0 0 </pose>
            <topic>oak/depth</topic>
            <update_rate>30</update_rate>
            <always_on>1</always_on>
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <camera>
                <horizontal_fov>1.51843645</horizontal_fov>
                <image>
                    <format>R_FLOAT32</format>
                    <width>1280</width>
                    <height>720</height>
                </image>
                <clip>
                    <near>0.28</near>
                    <far>10</far>
                </clip>
            </camera>
            <plugin filename="libgz-sim8-sensors-system.so" name="gz::sim::v8::systems::Sensors"></plugin>
        </sensor>
    </gazebo>

    <gazebo reference="camera_link">
        <sensor name="oak_color" type="camera">
            <pose> 0 0 0 0 0 0 </pose>
            <topic>oak/color</topic>
            <update_rate>30</update_rate>
            <always_on>1</always_on>
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <camera>
                <horizontal_fov>1.51843645</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>1280</width>
                    <height>720</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>100</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>
</robot>