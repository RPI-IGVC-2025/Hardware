{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "colcon",
			"args": [
				"build",
				"--symlink-install"
			],
			"problemMatcher": [
				"$colcon-gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "colcon: Colcon Build Release"
		},
		{
			"type": "colcon",
			"args": [
				"build",
				"--symlink-install",
				"--cmake-args",
				"-DCMAKE_BUILD_TYPE=RelWithDebInfo"
			],
			"label": "colcon: Colcon Build Test",
			"problemMatcher": [],
			"group": {
				"kind": "test",
				"isDefault": true
			}
		},
		{
			"type": "colcon",
			"args": [
				"build",
				"--symlink-install",
				"--cmake-args",
				"-DCMAKE_BUILD_TYPE=Debug"
			],
			"problemMatcher": [
				"$colcon-gcc"
			],
			"label": "colcon: Colcon Build Debug"
		}
	]
}